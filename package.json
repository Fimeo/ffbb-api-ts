{
  "name": "ffbb-api-client",
  "version": "0.2.0",
  "description": "TypeScript client for the FFBB (French Basketball Federation) API - Directus REST & Meilisearch",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "author": "Fimeo",
  "repository": {
    "type": "git",
    "url": "https://github.com/Fimeo/ffbb-api-ts"
  },
  "homepage": "https://github.com/Fimeo/ffbb-api-ts#readme",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "ffbb",
    "basketball",
    "france",
    "api",
    "directus",
    "meilisearch",
    "federation"
  ],
  "license": "MIT",
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.9.3",
    "vitest": "^3.0.0"
  }
}
